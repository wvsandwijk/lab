<virtualmachines path="C:\Hyper-V">
    <virtualmachine>
        <name>Win2025-1</name>
        <description>Windows 2025 VM 1 (CORE)</description>
        <SwitchName>LiveNetwork</SwitchName>
        <vlan/>
        <Path>C:\Hyper-V</Path>
        <disks>
            <disk number="0" name="OS" SizeGB="127"/>
            <disk number="1" name="D" SizeGB="10"/>
            <disk number="2" name="E" SizeGB="10"/>
        </disks>
        <cdroms>
            <cdrom number="1" name="InstallMedia" iso="C:\ISO\w2025.iso"/>
            <cdrom number="2" name="UnattendMedia" iso="C:\ISO\Autounattend_core_2025.iso"/>
        </cdroms>
    </virtualmachine>
